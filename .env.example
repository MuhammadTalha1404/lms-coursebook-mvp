# Copy this file to .env for manual setup, or run python scripts/setup.py.
# Do not put your MySQL root account in the application's configuration.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lms
DB_USER=lms_app
DB_PASSWORD=REPLACE_WITH_YOUR_APP_DATABASE_PASSWORD
# Optional CA file for a remote TLS-enabled MySQL server.
DB_SSL_CA=

INSTITUTE_NAME=Learning & Training Institute
APP_CURRENCY=PKR
# sample: show a clear sample-data notice. live: your own academic records.
APP_DATA_MODE=sample
# Set a real institute contact before using this with real student data.
PRIVACY_CONTACT=

# Used only by Docker Compose. Replace both before starting Docker.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_ROOT_PASSWORD
